# Copy to .env and fill in. NEVER commit .env.

# PayPal Sandbox (developer.paypal.com -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# Database
DATABASE_URL=sqlite:///./agentpay.db

# Dashboard / approval key (change this!)
ADMIN_KEY=admin-demo-key

# Optional LLM goal-consistency review (Anthropic API). Leave empty to skip.
LLM_API_KEY=
LLM_MODEL=

APP_ENV=development
