# Copy to .env and fill in. NEVER commit .env.

# PayPal Sandbox (developer.paypal.com -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# Database
DATABASE_URL=sqlite:///./agentpay.db

# LLM risk review (optional: falls back to deterministic heuristics if empty)
LLM_API_KEY=
LLM_MODEL=

# App
APP_ENV=development
